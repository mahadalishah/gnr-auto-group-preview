    $('.ct-slick-slider').each(function () {
        var slider_main = $(this).find('.ct-slick-carousel');
        var slider_nav = $(this).find('.ct-slick-nav');
        $(slider_nav).slick({
            slidesToShow: parseInt(slider_nav.attr('data-nav')),
            slidesToScroll: 1,
            asNavFor: slider_main,
            dots: false,
            arrows: slider_nav.data('arrows'),
            centerMode: true,
            infinite: slider_nav.data('infinite'),
            focusOnSelect: true,
            autoplay: false,
            autoplaySpeed: 8000,
            speed: 800,
            nextArrow: '<span class="slick-next bravisicon-angle-arrow-right"></span>',
            prevArrow: '<span class="slick-prev bravisicon-angle-arrow-left"></span>',
            rtl: true === slider_nav.data('dir'),
            responsive: [
                {
                    breakpoint: 768,
                    settings: {
                        slidesToShow: 1
                    }
                }
            ]
        });
    });

    $('.ct-slider-carousel2').each(function () {
        var status = $(this).find(".slick-count");
        var carouselInner = $(this).find(".ct-slick-dots");
        var slickElement = $(this).find(".ct-slick-carousel");

        slickElement.on('init reInit afterChange', function (event, slick, currentSlide, nextSlide) {
            if(!slick.$dots){
                return;
            }
            carouselInner.append(slick.$dots);
            var i = (currentSlide ? currentSlide : 0) + 1;
            status.text(i + '/' + (slick.$dots[0].children.length));
        });
    });

    // Make sure you run this code under Elementor.
